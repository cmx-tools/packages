{
  "name": "content-management-jsx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "verify": "corepack pnpm run fmt:check && corepack pnpm run typecheck && corepack pnpm run test",
    "build": "corepack pnpm -r --filter './packages/*' build",
    "pretest:unit": "corepack pnpm run build",
    "test:unit": "vitest run --dir packages",
    "pretest:integration": "corepack pnpm run build",
    "test:integration": "vitest run --dir test",
    "test": "corepack pnpm run test:unit && corepack pnpm run test:integration",
    "typecheck": "corepack pnpm run build && corepack pnpm -r --filter './packages/*' typecheck && tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^24.12.2",
    "cmx-contracts": "workspace:*",
    "cmx-bundler": "workspace:*",
    "cmx-document-renderer": "workspace:*",
    "cmx-react": "workspace:*",
    "cmx-runtime": "workspace:*",
    "esbuild": "^0.28.0",
    "oxc-parser": "^0.128.0",
    "prettier": "^3.8.3",
    "rolldown": "^1.0.0-rc.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
