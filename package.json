{
  "name": "content-management-jsx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "exports": {
    "./cmx-bundle": "./src/cmx-bundle.ts",
    "./cmx-bundler": "./src/cmx-bundler/index.ts",
