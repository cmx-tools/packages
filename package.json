{
  "name": "content-management-jsx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "verify": "corepack pnpm run fmt:check && corepack pnpm run typecheck && corepack pnpm run test",
    "build": "corepack pnpm -r --filter './packages/*' build",
    "test:unit": "vitest run --dir packages",
    "pretest:integration": "corepack pnpm run build",
    "test:integration": "vitest run --dir test",
    "test": "corepack pnpm run test:unit && corepack pnpm run test:integration && corepack pnpm run verify:example",
    "typecheck": "corepack pnpm run build && corepack pnpm -r --filter './packages/*' typecheck && tsc --noEmit",
    "example:create-documents": "corepack pnpm -r --filter '@example/content' build",
    "example:create-environment": "corepack pnpm -r --filter '@example/backend' build",
    "test:gen-example": "corepack pnpm run example:create-documents && corepack pnpm run example:create-environment && prettier --write example/",
    "preverify:example": "corepack pnpm run test:gen-example",
    "verify:example": "git update-index -q --refresh && test -z \"$(git status --porcelain -- ./example)\"",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check ."
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/node": "^24.12.2",
    "cmx-contracts": "workspace:*",
    "cmx-bundler": "workspace:*",
    "cmx-document-renderer": "workspace:*",
    "cmx-react": "workspace:*",
    "cmx-runtime": "workspace:*",
    "prettier": "^3.8.3",
    "rolldown": "^1.0.0-rc.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
