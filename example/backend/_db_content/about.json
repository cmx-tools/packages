{
  "$schema": "https://example.org/todo.v1.json",
  "cmxVersion": 1,
  "dependencies": [
    {
      "name": "@example/backend-contract",
      "specifier": "workspace:*",
      "version": "0.1.0"
    },
    {
      "name": "@example/ui-library",
      "specifier": "workspace:*",
      "version": "0.1.0"
    }
  ],
  "meta": {
    "type": {
      "from": "@example/backend-contract",
      "import": "Meta"
