{
  "name": "@example/content",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm run compile --watch",
    "typecheck": "corepack pnpm run build && tsgo -p tsconfig.json",
    "compile": "cmx-bundle compile \"pages/**/*.tsx\" dist --config ../cmx.config.ts",
    "render": "cmx-document render dist --complete-only",
    "build": "corepack pnpm run compile",
    "publish": "corepack pnpm run compile && cmx-document render dist --complete-only | cmx publish - \"${CMX_PUBLISH_ENDPOINT:-http://127.0.0.1:3000/_cmx/publication}\""
  },
  "dependencies": {
    "@example/ui-library": "workspace:*",
    "@example/backend-contract": "workspace:*"
  },
  "devDependencies": {
    "@cmx-tools/assets": "workspace:^",
    "@types/node": "^24.12.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@cmx-tools/bundle": "workspace:^",
    "@cmx-tools/document": "workspace:^",
    "rolldown": "^1.0.0-rc.18",
    "@cmx-tools/cli": "workspace:^",
    "tsx": "^4.21.0"
  }
}
