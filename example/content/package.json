{
  "name": "@example/content",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "cmx-bundle compile \"pages/**/*.tsx\" dist --config ../cmx.config.ts",
    "render": "cmx-document render dist --out-dir ../backend/_db_content",
    "build": "corepack pnpm run compile && corepack pnpm run render"
  },
  "dependencies": {
    "@example/ui-library": "workspace:*",
    "@example/backend-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@cmx-tools/bundle": "workspace:^",
    "@cmx-tools/document": "workspace:^",
    "rolldown": "^1.0.0-rc.18",
    "@cmx-tools/cli": "workspace:^",
    "tsx": "^4.21.0"
  }
}
