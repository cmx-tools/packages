{
  "name": "cmx-document",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cmx-document": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "pretest": "corepack pnpm run build",
    "test": "vitest run",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "rolldown": "^1.0.0-rc.18"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "cmx-contracts": "workspace:*",
    "cmx-runtime": "workspace:*"
  }
}
