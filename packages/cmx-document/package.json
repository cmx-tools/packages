{
  "name": "cmx-document",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "cmx-document": "./dist/cli/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./cli": {
      "types": "./dist/cli/cmxDocumentCli.d.ts",
      "import": "./dist/cli/cmxDocumentCli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "pretest": "corepack pnpm run build",
    "test": "vitest run",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "cmx-contracts": "workspace:*",
    "cmx-runtime": "workspace:*"
  },
  "peerDependencies": {
    "cmx-cli": "^0.1.0 || ^1.0.0"
  },
  "peerDependenciesMeta": {
    "cmx-cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "cmx-cli": "workspace:*",
    "rolldown": "^1.0.0-rc.18"
  }
}
