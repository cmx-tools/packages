{
  "name": "cmx-environment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cmx-environment": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "pretest": "corepack pnpm run build",
    "test": "vitest run",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cmx-cli-config": "workspace:*",
    "cmx-contracts": "workspace:*"
  }
}
