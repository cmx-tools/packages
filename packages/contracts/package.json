{
  "name": "@cmx-tools/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "corepack pnpm exec json2ts -i schema/cmx-document.v1.schema.json -o schema/cmx-document.v1.schema.generated.ts --unknownAny",
    "build": "tsgo -p tsconfig.json ",
    "pretest": "corepack pnpm run build",
    "test": "vitest run --dir src",
    "pretest:integration": "corepack pnpm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^6.0.3"
  }
}
