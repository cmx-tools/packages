{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "noUnusedLocals": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "cli/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "cli/**/*.test.ts", "dist"]
}
