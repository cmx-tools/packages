{
  "name": "cmx-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cmx": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cmxCli.d.ts",
      "import": "./dist/cmxCli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.json",
    "pretest": "corepack pnpm run build",
    "test": "vitest run --dir src",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "c12": "^3.3.1",
    "cmx-contracts": "workspace:*"
  }
}
