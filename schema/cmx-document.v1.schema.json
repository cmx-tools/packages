{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cmx.xiphe.net/schemas/cmx-document.v1.schema.json",
  "title": "CMX Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "cmxVersion", "dependencies", "tree"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cmxVersion": {
      "const": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dependency"
      }
    },
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "tree": {
      "$ref": "#/definitions/node"
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "specifier", "version"],
      "properties": {
        "name": {
          "type": "string"
        },
        "specifier": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "integrity": {
          "type": "string"
        }
      }
    },
    "metaType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {
          "type": "string"
        },
        "import": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "type": {
          "$ref": "#/definitions/metaType"
        },
        "data": {
          "description": "Opaque meta payload. Shape is defined by the referenced meta type."
        }
      }
    },
    "slotPath": {
      "type": "array",
      "items": {
        "type": ["string", "number"]
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/fragmentNode"
        },
        {
          "$ref": "#/definitions/elementNode"
        },
        {
          "$ref": "#/definitions/componentNode"
        }
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "props": {
      "type": "object"
    },
    "fragmentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "fragment"
        },
        "children": {
          "$ref": "#/definitions/children"
        }
      }
    },
    "elementNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "tag"],
      "properties": {
        "type": {
          "const": "element"
        },
        "tag": {
          "type": "string"
        },
        "props": {
          "$ref": "#/definitions/props"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slotPath"
          }
        },
        "children": {
          "$ref": "#/definitions/children"
        }
      }
    },
    "componentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from"],
      "properties": {
        "type": {
          "const": "component"
        },
        "from": {
          "type": "string"
        },
        "import": {
          "type": "string"
        },
        "props": {
          "$ref": "#/definitions/props"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/slotPath"
          }
        },
        "children": {
          "$ref": "#/definitions/children"
        }
      }
    }
  }
}
